# Gemini（Vertex AI）を呼ぶGCPプロジェクト。merukariと同じ課金有効プロジェクトを流用
# ローカルは `gcloud auth application-default login` の認証情報を自動で使う
GOOGLE_VERTEX_PROJECT="merukari-app-2414"
# Vercel本番のみ: サービスアカウントJSON（1行）
GOOGLE_VERTEX_CREDENTIALS=

# Vercel Blob（投稿プランと画像の一時保存）。Vercelでストアを接続すると自動で入る
BLOB_READ_WRITE_TOKEN=

# LINE Developers > Messaging APIチャネル
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LINE Developers > LINEログインチャネル（LIFF用）の Channel ID と LIFF ID
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# 公開URL（LINEに送る画像・リンクの組み立てに使う）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 古いデータを消すCronの合言葉
CRON_SECRET=


# 公開Blobストアのベースurl（vercel blob put の結果URLのドメイン部分）
NEXT_PUBLIC_BLOB_BASE_URL=
